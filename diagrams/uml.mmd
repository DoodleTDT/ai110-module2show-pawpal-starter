classDiagram
    class User {
        +str name
        +list~Pet~ pets
        +list~Task~ tasks
        +Time wake_time
        +Time sleep_time
        +list~Schedule~ candidates
        +Schedule saved_schedule
        +add_pet(pet) None
        +add_task(task) None
        +delete_task(task_id) None
        +set_priority(task_id, priority) None
        +set_time_preference(task_id, window, duration) None
        +add_event(title, start, end) None
        +get_pet(pet_id) Pet
        +tasks_for_pet(pet_id) list~Task~
        +tasks_for_species(species) list~Task~
        +tasks_by_pet() dict~str, list~Task~~
        +personal_tasks() list~Task~
        +awake_window() tuple
        +request_schedule(strategy) Schedule
        +request_alternative(strategy) Schedule
        +compare_candidates() str
        +choose_schedule(schedule_id) Schedule
        +discard_unchosen(schedule_id) None
        +get_saved_schedule() Schedule
    }

    class Pet {
        +str pet_id
        +str name
        +str species
        +int age
        +str notes
    }

    class Task {
        +str task_id
        +str title
        +str category
        +int priority
        +int duration_minutes
        +Time preferred_start
        +Time preferred_end
        +bool is_fixed
        +list~Pet~ pets
        +is_pet_task() bool
        +is_for_pet(pet_id) bool
        +add_pet(pet) None
        +remove_pet(pet_id) None
        +pet_names() list~str~
        +blocks(start, end) bool
        +describe() str
    }

    class Schedule {
        +str schedule_id
        +str label
        +Date day
        +str strategy
        +bool is_saved
        +dict~str, tuple~ placements
        +build(tasks, wake_time, sleep_time) None
        +place_task(task) bool
        +is_free(start, end) bool
        +sort_by_strategy(tasks) list~Task~
        +placed_tasks() list~Task~
        +unplaced_tasks() list~Task~
        +summary() dict
        +explain() str
    }

    User "1" --> "0..*" Pet : owns
    User "1" --> "0..*" Task : creates
    Task "0..*" --> "0..*" Pet : is for
    User "1" --> "0..2" Schedule : reviews candidates
    User "1" --> "0..1" Schedule : saved_schedule
    Schedule "0..*" ..> "0..*" Task : places
